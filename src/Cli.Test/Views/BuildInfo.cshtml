@* Shown at / while the site has no published content (Umbraco:CMS:Global:NoNodesViewPath).
   Displays which build is running, so CI deployments to test / the live slot / live are visible. *@
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    Layout = null;
    var markerPath = System.IO.Path.Combine(HostEnvironment.WebRootPath ?? "", "build-info.txt");
    var sha = System.IO.File.Exists(markerPath) ? System.IO.File.ReadAllText(markerPath).Trim() : "local build";
    var shortSha = sha.Length > 7 ? sha[..7] : sha;
    var host = Context.Request.Host.Host;
    var environment = host.StartsWith("prewarm-") ? "live (slot)"
        : host.StartsWith("test-") ? "test"
        : host.StartsWith("localhost") ? "local"
        : "live";
    var copenhagen = TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen");
    var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, copenhagen);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cli-test · @environment</title>
    <style>
        :root { color-scheme: light dark; --bg: #f6f4f0; --fg: #1b264f; --muted: #5c6477; --card: #fff; --accent: #3544b1; }
        @@media (prefers-color-scheme: dark) { :root { --bg: #14182b; --fg: #eef0f8; --muted: #a3a9bd; --card: #1e2440; --accent: #9aa7ff; } }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--fg);
               font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; padding: 16px; box-sizing: border-box; }
        main { background: var(--card); border-radius: 12px; padding: 32px; max-width: 520px; width: 100%;
               box-shadow: 0 4px 24px rgb(0 0 0 / .08); }
        h1 { margin: 0 0 4px; font-size: 1.6rem; }
        .env { display: inline-block; margin-bottom: 24px; padding: 2px 10px; border-radius: 999px;
               background: var(--accent); color: var(--card); font-weight: 600; font-size: .9rem; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 16px; margin: 0; }
        dt { color: var(--muted); }
        dd { margin: 0; font-family: ui-monospace, Consolas, monospace; overflow-wrap: anywhere; }
        a { color: var(--accent); }
    </style>
</head>
<body>
<main>
    <h1>Cli-test is running</h1>
    <span class="env">@environment</span>
    <dl>
        <dt>Build</dt>
        <dd>@if (sha.Length == 40) {<a href="https://github.com/jemayn/Cli-test/commit/@sha">@shortSha</a>} else {@sha}</dd>
        <dt>Host</dt>
        <dd>@host</dd>
        <dt>Rendered</dt>
        <dd>@now.ToString("dd-MM-yyyy HH:mm:ss") (Copenhagen)</dd>
    </dl>
</main>
</body>
</html>
